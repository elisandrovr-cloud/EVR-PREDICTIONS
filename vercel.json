{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/next" },
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "250mb" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/api/index.py" },
    { "src": "/docs", "dest": "backend/api/index.py" },
    { "src": "/redoc", "dest": "backend/api/index.py" },
    { "src": "/openapi.json", "dest": "backend/api/index.py" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ],
  "crons": [
    { "path": "/api/v1/cron/refresh", "schedule": "*/2 * * * *" },
    { "path": "/api/v1/cron/stats", "schedule": "*/30 * * * *" },
    { "path": "/api/v1/cron/bootstrap", "schedule": "0 6 * * *" },
    { "path": "/api/v1/cron/close-day", "schedule": "30 8 * * *" }
  ]
}
