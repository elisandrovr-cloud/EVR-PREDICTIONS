# EVR Emulator - configuracion del middleware.
# Copia este archivo a .env y ajusta los valores.

# Puerto del servidor local (API REST + WebSocket + consola web)
EVR_PORT=5555

# Interfaz de escucha (127.0.0.1 = solo local, recomendado)
EVR_HOST=127.0.0.1

# Ruta al binario adb. Vacio = se resuelve solo, en este orden:
#   ../bin/platform-tools/adb[.exe]  ->  $ANDROID_HOME/platform-tools  ->  PATH
EVR_ADB_PATH=

# Ruta a scrcpy. Vacio = ../bin/scrcpy/scrcpy[.exe] o el PATH.
EVR_SCRCPY_PATH=

# Interprete con el que ejecutar EVR_ADB_PATH (vacio = ejecutarlo directamente).
# Solo hace falta para apuntar a un adb simulado, como en las pruebas.
EVR_ADB_LAUNCHER=

# Serial/endpoint del dispositivo por defecto.
# 127.0.0.1:4444 es el puerto que reenvia launch-vm hacia el 5555 del guest.
# Para un AVD de Android Studio suele ser emulator-5554.
EVR_DEFAULT_SERIAL=127.0.0.1:4444

# Cada cuantos ms reintentar `adb connect` contra EVR_DEFAULT_SERIAL (0 = off)
EVR_AUTOCONNECT_MS=5000

# Fotogramas por segundo del canal de video /ws/video (1-30)
EVR_STREAM_FPS=8

# Nivel de log: error | warn | info | debug
EVR_LOG_LEVEL=info
