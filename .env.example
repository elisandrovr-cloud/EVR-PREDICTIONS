# ── EVR MLB AI PRO — environment configuration ────────────────────────────────
# Copy to .env and fill in real values. `docker compose up` reads this file.

# Postgres
POSTGRES_USER=evr
POSTGRES_PASSWORD=evr_secret_change_me
POSTGRES_DB=evr_mlb
DATABASE_URL=postgresql+psycopg2://evr:evr_secret_change_me@postgres:5432/evr_mlb

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Security
SECRET_KEY=change_me_to_a_64_char_random_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# OAuth (optional — leave empty to disable a provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost/api/v1/auth/oauth

# External data providers (free tiers work; empty key disables the source)
ODDS_API_KEY=
OPENWEATHER_API_KEY=

# App
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
DATA_REFRESH_SECONDS=120
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_URL=/api/v1
